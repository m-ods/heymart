# MongoDB connection string (optional, only for development with MongoDB)
# DATABASE_URI=mongodb://127.0.0.1/heymart

# SQLite database file path (for local development)
DATABASE_FILE_PATH=./db/database.db

# Payload CMS secret key (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your-secret-key-here

# Cloudflare R2 credentials (for media storage)
# Get these from your Cloudflare dashboard
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=heymart-media
R2_PUBLIC_URL=https://your-public-url.r2.dev

# Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
