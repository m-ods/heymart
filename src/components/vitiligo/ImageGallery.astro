---
interface Props {
  images: string[];
}

const { images } = Astro.props;
---

{images.length > 0 ? (
  <div class="image-gallery">
    {images.map((src) => (
      <div class="gallery-item">
        <img src={src} alt="" loading="lazy" />
      </div>
    ))}
  </div>
) : (
  <div class="image-gallery">
    {Array.from({ length: 5 }).map(() => (
      <div class="gallery-item placeholder">
        <div class="placeholder-img"></div>
      </div>
    ))}
  </div>
)}

<style>
  .image-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 1.5rem 0 0;
  }

  .gallery-item {
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 2px 2px 8px var(--shadow, rgba(0, 0, 0, 0.06));
    border: 1px solid var(--gallery-border, #e0e0e0);
    background: var(--gallery-bg, #f0f0f0);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder-img {
    width: 100%;
    height: 100%;
    background: var(--placeholder-bg, #e8e8e8);
  }

  @media (max-width: 600px) {
    .image-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
</style>
