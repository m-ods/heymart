---
const posts = [
	{
		title: "You should work out of whatever platform you like",
		href: "/blog/platform-agnostic-work",
	},
	{
		title: "Humans love bathing",
		href: "/blog/humans-love-bathing",
	},
	{
		title: "Confessions of a Hedonist",
		href: "/blog/confessions-of-a-hedonist",
	},
];

const topLinks = [
	{ label: "X (Twitter)", href: "https://x.com/martschweiger" },
	{ label: "GitHub", href: "https://github.com/m-ods" },
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/martinschweiger/" },
	{ label: "YouTube", href: "#" },
	{ label: "Email", href: "mailto:martin@assemblyai.com" },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>HEYMART</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bungee&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main class="container">
			<header class="logo-row">
				<h1 class="logo">HeyMart</h1>
			</header>

			<div class="content">
				<section class="about-box" aria-labelledby="about-heading">
					<div class="box-header about-header">
						<span id="about-heading">Hello! I'm Mart</span>
					</div>
					<div class="about-content">
						<p>This is my corner of the internet where I plan to build a public record of my work.</p>
						<p>First of all you should know that I'm a husband, father, and a hacker. I work at <a href="https://www.assemblyai.com/" target="_blank" rel="noopener noreferrer">AssemblyAI</a>.</p>
						<p>You can see a rough breakdown of what I'm up to <a href="/now">here</a>.</p>

						<h2>Some quick facts:</h2>
						<ul>
							<li>I taught myself to code by doing challenges on <a href="https://codingbat.com" target="_blank" rel="noopener noreferrer">CodingBat</a>.</li>
							<li>I live in sunny Singapore 🇸🇬 with my wife and daughter.</li>
							<li>I really like computers, jets, coffee, music, and games.</li>
						</ul>

						<p>Feel free to explore my site and get in touch! I love making friends with new people :)</p>

						<div class="writing-block">
							<h2>Scribbles</h2>
							<ul class="post-list">
								{posts.map((post) => (
									<li>
										<a href={post.href}>{post.title}</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				</section>

				<aside class="links-box" aria-labelledby="links-heading">
					<div class="box-header links-header">
						<span id="links-heading">Top Links</span>
					</div>
					<ol class="links-list">
						{topLinks.map((link, i) => (
							<li>
								<span class="link-index">{i + 1}.</span>
								<a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
									{link.label}
								</a>
							</li>
						))}
					</ol>
				</aside>
			</div>
		</main>

		<style>
			@font-face {
				font-family: "DistantGalaxy";
				src: url("/fonts/DISTGRG_.ttf") format("truetype");
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				font-family: Verdana, system-ui, sans-serif;
				background: #3d3d3d;
				color: #1a1a1a;
			}

			body {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 24px;
			}

			.container {
				background: #ffffff;
				border-radius: 8px;
				width: 100%;
				max-width: 1040px;
				padding: 20px;
				display: flex;
				flex-direction: column;
				gap: 16px;
			}

			.logo-row {
				padding: 18px 24px 8px;
			}

			.logo {
				font-family: "DistantGalaxy", sans-serif;
				font-size: clamp(56px, 11vw, 100px);
				background: linear-gradient(180deg, #ff8533 22%, #e43a1e 50%, #b31515 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				letter-spacing: -0.01em;
				line-height: 0.75;
			}

			.content {
				display: flex;
				align-items: flex-start;
				gap: 20px;
				padding: 0 4px 4px;
			}

			.about-box {
				flex: 3 1 0;
				min-width: 0;
				background: #00acff;
				border: 8px solid #d4f2ff;
				border-radius: 8px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}

			.links-box {
				flex: 1 1 0;
				min-width: 0;
				background: #fff8e1;
				border: 6px solid #ffd48b;
				border-radius: 8px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}

			.box-header {
				padding: 8px 16px;
				font-family: Verdana, system-ui, sans-serif;
				font-weight: 700;
				font-size: 18px;
				line-height: 22px;
				color: #ffffff;
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.links-header {
				background: linear-gradient(180deg, #ffb347 0%, #e88b1a 100%);
			}

			.about-header {
				background: linear-gradient(180deg, #2ab7ff 0%, #008bd6 100%);
				padding-block: 10px;
			}

			.about-content {
				background: #ffffff;
				margin: 0;
				padding: 24px 26px 28px;
				display: flex;
				flex-direction: column;
				gap: 16px;
				font-size: 17px;
				line-height: 1.6;
			}

			.about-content h2 {
				font-size: 24px;
				line-height: 1.2;
				margin: 8px 0 0;
			}

			.about-content ul {
				padding-left: 24px;
				display: flex;
				flex-direction: column;
				gap: 6px;
			}

			.about-content a,
			.post-list a {
				color: #1155cc;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 2px;
			}

			.about-content a:hover,
			.post-list a:hover {
				color: #0b3d91;
			}

			.writing-block {
				border-top: 1px solid #d9e8f4;
				margin-top: 8px;
				padding-top: 20px;
				display: flex;
				flex-direction: column;
				gap: 12px;
			}

			.post-list {
				list-style: none;
				padding-left: 0;
				display: flex;
				flex-direction: column;
				gap: 14px;
			}

			.post-list li {
				display: flex;
				flex-direction: column;
				gap: 4px;
			}

			.post-list a {
				font-weight: 700;
			}

			.links-list {
				list-style: none;
				padding: 12px 16px;
				display: flex;
				flex-direction: column;
				gap: 6px;
			}

			.links-list li {
				display: flex;
				align-items: center;
				gap: 8px;
				font-weight: 700;
				font-size: 13px;
				line-height: 16px;
			}

			.link-index {
				width: 20px;
				flex-shrink: 0;
				color: #333333;
			}

			.links-list a {
				color: #1155cc;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 2px;
			}

			.links-list a:hover {
				color: #0b3d91;
			}

			@media (max-width: 768px) {
				body {
					padding: 12px;
					align-items: flex-start;
				}

				.container {
					padding: 12px;
				}

				.logo-row {
					padding: 10px 6px 4px;
				}

				.content {
					flex-direction: column;
				}

				.about-box,
				.links-box {
					flex: 0 0 auto;
				}

				.about-content {
					padding: 18px;
					font-size: 15px;
				}

				.about-content h2 {
					font-size: 20px;
				}
			}
		</style>
	</body>
</html>
