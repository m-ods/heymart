		<style>
			@font-face {
				font-family: 'DistantGalaxy';
				src: url('/fonts/DISTGRG_.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			:root {
				--bg: #0a0a0a;
				--text: #e0e0e0;
				--accent: #ff6b35;
				--link-hover: #ff8c61;
			}

			html {
				font-family: 'JetBrains Mono', monospace;
				background: var(--bg);
				color: var(--text);
			}

			body {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 2rem;
			}

			main {
				text-align: center;
				max-width: 100%;
			}

		.logo {
			font-family: 'DistantGalaxy', sans-serif;
			font-size: clamp(3rem, 15vw, 8rem);
			background: linear-gradient(180deg, #ff8533 0%, #cc1a1a 100%);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
			letter-spacing: 0.05em;
			margin-bottom: 3rem;
			line-height: 1.2;
		}

			.links {
				display: flex;
				gap: 2rem;
				justify-content: center;
				flex-wrap: wrap;
			}

			.links a {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--text);
				text-decoration: none;
				font-size: 1rem;
				font-weight: 500;
				padding: 0.75rem 1.25rem;
				border: 1px solid rgba(224, 224, 224, 0.2);
				border-radius: 8px;
				transition: all 0.2s ease;
			}

			.links a:hover {
				color: var(--accent);
				border-color: var(--accent);
				transform: translateY(-2px);
				box-shadow: 0 4px 12px rgba(255, 107, 53, 0.2);
			}

			.links a svg {
				flex-shrink: 0;
			}

			@media (max-width: 640px) {
				body {
					padding: 1.5rem;
				}

				.logo {
					margin-bottom: 2rem;
				}

				.links {
					gap: 1rem;
					flex-direction: column;
					align-items: stretch;
				}

				.links a {
					justify-content: center;
				}
			}
		</style>
	</body>
</html>
