---
const apps = [
	{
		title: "VITILIGO\nTRACKER",
		label: "Vitiligo Tracker",
		description: "Track your skin's journey",
		href: "/vitiligo",
		gradient: "linear-gradient(135deg, #5b48a8 0%, #7c6cc1 50%, #b3abd2 100%)",
	},
	{
		title: "WIKI",
		label: "Wiki",
		description: "Personal knowledge base",
		href: "/wiki",
		gradient: "linear-gradient(135deg, #2b7d3e 0%, #4ea862 50%, #7dc48a 100%)",
	},
	{
		title: "TIMEBOX",
		label: "Timebox",
		description: "Focus timer for deep work",
		href: "/timebox",
		gradient: "linear-gradient(135deg, #1a4c82 0%, #3a77b3 50%, #75a6d0 100%)",
	},
];

const topLinks = [
	{ label: "X (Twitter)", href: "https://x.com/martschweiger" },
	{ label: "GitHub", href: "https://github.com/m-ods" },
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/martinschweiger/" },
	{ label: "YouTube", href: "#" },
	{ label: "Email", href: "mailto:martin@assemblyai.com" },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>HEYMART</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Bungee&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main class="container">
			<header class="logo-row">
				<h1 class="logo">HeyMart</h1>
			</header>

			<div class="content">
				<section class="apps-box" aria-labelledby="apps-heading">
					<div class="box-header apps-header">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="#FFFFFF" aria-hidden="true">
							<path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z" />
						</svg>
						<span id="apps-heading">Latest Apps</span>
					</div>
					<div class="apps-grid">
						{apps.map((app) => (
							<a class="app-card" href={app.href}>
								<div class="app-tile" style={`background-image: ${app.gradient}`}>
									<span class="app-title">{app.title}</span>
								</div>
								<div class="app-label">{app.label}</div>
								<div class="app-description">{app.description}</div>
							</a>
						))}
					</div>
				</section>

				<aside class="links-box" aria-labelledby="links-heading">
					<div class="box-header links-header">
						<span id="links-heading">Top Links</span>
					</div>
					<ol class="links-list">
						{topLinks.map((link, i) => (
							<li>
								<span class="link-index">{i + 1}.</span>
								<a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}>
									{link.label}
								</a>
							</li>
						))}
					</ol>
				</aside>
			</div>
		</main>

		<style>
			@font-face {
				font-family: "DistantGalaxy";
				src: url("/fonts/DISTGRG_.ttf") format("truetype");
				font-weight: normal;
				font-style: normal;
				font-display: swap;
			}

			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				font-family: Verdana, system-ui, sans-serif;
				background: #3d3d3d;
				color: #1a1a1a;
			}

			body {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 24px;
			}

			.container {
				background: #ffffff;
				border-radius: 8px;
				width: 100%;
				max-width: 1040px;
				padding: 20px;
				display: flex;
				flex-direction: column;
				gap: 16px;
			}

			.logo-row {
				padding: 12px 20px 0;
			}

			.logo {
				font-family: "DistantGalaxy", sans-serif;
				font-size: clamp(56px, 11vw, 100px);
				background: linear-gradient(180deg, #ff8533 22%, #e43a1e 50%, #b31515 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				letter-spacing: -0.01em;
				line-height: 0.75;
			}

			.content {
				display: flex;
				gap: 16px;
				padding: 0 0 4px;
			}

			.apps-box {
				flex: 3 1 0;
				min-width: 0;
				background: #00acff;
				border: 6px solid #d4f2ff;
				border-radius: 8px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}

			.links-box {
				flex: 1 1 0;
				min-width: 0;
				background: #fff8e1;
				border: 6px solid #ffd48b;
				border-radius: 8px;
				overflow: hidden;
				display: flex;
				flex-direction: column;
			}

			.box-header {
				padding: 8px 16px;
				font-family: Verdana, system-ui, sans-serif;
				font-weight: 700;
				font-size: 18px;
				line-height: 22px;
				color: #ffffff;
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.links-header {
				background: linear-gradient(180deg, #ffb347 0%, #e88b1a 100%);
			}

			.apps-grid {
				background: #ffffff;
				padding: 10px;
				display: flex;
				gap: 8px;
			}

			.app-card {
				flex: 1 1 0;
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 6px;
				text-decoration: none;
				color: inherit;
			}

			.app-tile {
				border: 2px solid #3b89c9;
				border-radius: 6px;
				height: 180px;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: transform 0.15s ease, box-shadow 0.15s ease;
			}

			.app-card:hover .app-tile {
				transform: translateY(-2px);
				box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
			}

			.app-title {
				font-family: "Bungee", system-ui, sans-serif;
				font-size: 22px;
				line-height: 28px;
				color: #ffffff;
				text-align: center;
				white-space: pre-line;
			}

			.app-label {
				font-weight: 700;
				font-size: 13px;
				line-height: 16px;
				color: #1a1a1a;
			}

			.app-description {
				font-size: 11px;
				line-height: 14px;
				color: #555555;
			}

			.links-list {
				list-style: none;
				padding: 12px 16px;
				display: flex;
				flex-direction: column;
				gap: 6px;
			}

			.links-list li {
				display: flex;
				align-items: center;
				gap: 8px;
				font-weight: 700;
				font-size: 13px;
				line-height: 16px;
			}

			.link-index {
				width: 20px;
				flex-shrink: 0;
				color: #333333;
			}

			.links-list a {
				color: #1155cc;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 2px;
			}

			.links-list a:hover {
				color: #0b3d91;
			}

			@media (max-width: 768px) {
				body {
					padding: 12px;
					align-items: flex-start;
				}

				.container {
					padding: 12px;
				}

				.logo-row {
					padding: 8px 4px 0;
				}

				.content {
					flex-direction: column;
				}

				.apps-box,
				.links-box {
					flex: 0 0 auto;
				}

				.links-box {
					order: -1;
				}

				.apps-grid {
					flex-direction: column;
				}

				.app-tile {
					height: 140px;
				}
			}
		</style>
	</body>
</html>
