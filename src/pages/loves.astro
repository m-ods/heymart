			{ label: "Strength training", href: "https://en.wikipedia.org/wiki/Strength_training" },
			{ label: "Pilates", href: "https://en.wikipedia.org/wiki/Pilates" },
			{ label: "Sauna", href: "https://en.wikipedia.org/wiki/Sauna" },
