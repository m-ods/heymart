---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Everything Mart loves — Stardew Valley edition." />
		<title>Loves - HEYMART</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;500;600;700&family=VT323&display=swap" rel="stylesheet" />
	</head>
	<body>
		<main class="page">
			<SiteHeader />

			<section class="game-shell" aria-labelledby="loves-heading">
				<div class="game-frame">
					<header class="hero">
						<div class="hero-mark" aria-hidden="true">
							<img src="/images/stardew-heart.png" alt="" width="48" height="48" class="hero-heart" />
						</div>
						<h1 id="loves-heading">Loves</h1>
					</header>

					<div class="boards">
						{loves.map((group) => (
							<section class="board" aria-labelledby={`group-${group.title}`}>
								<div class="board-header">
									<h2 id={`group-${group.title}`}>{group.title}</h2>
								</div>
								<ul class="gift-list">
									{group.items.map((item) => (
										<li class:list={[{ shout: item.shout }]}>
											<a href={item.href} target="_blank" rel="noopener noreferrer">
												{item.label}
											</a>
											{item.shout && <em class="shout-tag">LOVE JETS</em>}
										</li>
									))}
								</ul>
							</section>
						))}
					</div>
				</div>
			</section>
		</main>

		<style>
			* {
				box-sizing: border-box;
			}

			html {
				font-family: Verdana, system-ui, sans-serif;
				background: #3d3d3d;
				color: #1a1a1a;
			}

			body {
				margin: 0;
				min-height: 100vh;
				padding: 24px;
			}

			.page {
				width: 100%;
				max-width: 1040px;
				margin: 0 auto;
				background: #ffffff;
				border-radius: 8px;
				padding: 20px;
			}

			.game-shell {
				border: 8px solid #7ec850;
				border-radius: 10px;
				overflow: hidden;
				background:
					radial-gradient(circle at 12% 18%, rgba(255, 236, 150, 0.35), transparent 28%),
					radial-gradient(circle at 88% 8%, rgba(126, 200, 80, 0.28), transparent 24%),
					linear-gradient(180deg, #6ec4ff 0%, #87ceeb 28%, #b8e986 62%, #7ec850 100%);
				position: relative;
			}

			.game-shell::before {
				content: "";
				position: absolute;
				inset: 0;
				pointer-events: none;
				opacity: 0.18;
				background-image:
					linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
				background-size: 8px 8px;
				animation: drift 18s linear infinite;
			}

			.game-frame {
				position: relative;
				z-index: 1;
				margin: 14px;
				padding: 18px;
				border: 4px solid #5a3a1a;
				border-radius: 6px;
				background:
					linear-gradient(180deg, rgba(255, 248, 220, 0.96), rgba(245, 230, 190, 0.96)),
					repeating-linear-gradient(
						90deg,
						rgba(139, 90, 43, 0.04) 0 2px,
						transparent 2px 10px
					);
				box-shadow:
					inset 0 0 0 3px #c9a46a,
					0 8px 0 rgba(60, 40, 20, 0.18);
			}

			.hero {
				display: flex;
				align-items: center;
				gap: 18px;
				margin-bottom: 22px;
				padding: 8px 4px 18px;
				border-bottom: 3px solid #c9a46a;
			}

			.hero-mark {
				flex-shrink: 0;
				width: 72px;
				height: 72px;
				display: grid;
				place-items: center;
				background: #fff8dc;
				border: 3px solid #5a3a1a;
				box-shadow: inset 0 0 0 3px #c9a46a;
			}

			.hero-heart {
				image-rendering: pixelated;
				width: 48px;
				height: 48px;
				animation: heartbeat 1.4s ease-in-out infinite;
			}

			.hero h1 {
				margin: 0;
				font-family: "Pixelify Sans", "VT323", monospace;
				font-size: clamp(42px, 9vw, 72px);
				line-height: 0.95;
				color: #c62828;
				text-shadow:
					2px 0 #fff8dc,
					-2px 0 #fff8dc,
					0 2px #fff8dc,
					0 -2px #fff8dc,
					3px 3px 0 #5a3a1a;
			}

			.boards {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 14px;
			}

			.board {
				background: rgba(255, 252, 240, 0.88);
				border: 3px solid #8b5a2b;
				box-shadow: inset 0 0 0 2px #e8d5a8;
				padding: 12px 12px 14px;
				animation: rise-in 0.55s ease both;
			}

			.board:nth-child(1) { animation-delay: 0.05s; }
			.board:nth-child(2) { animation-delay: 0.1s; }
			.board:nth-child(3) { animation-delay: 0.15s; }
			.board:nth-child(4) { animation-delay: 0.2s; }
			.board:nth-child(5) { animation-delay: 0.25s; }
			.board:nth-child(6) { animation-delay: 0.3s; }
			.board:nth-child(7) { animation-delay: 0.35s; }
			.board:nth-child(8) { animation-delay: 0.4s; }

			.board-header {
				margin-bottom: 10px;
				padding-bottom: 8px;
				border-bottom: 2px dashed #c9a46a;
			}

			.board-header h2 {
				margin: 0;
				font-family: "Pixelify Sans", "VT323", monospace;
				font-size: 20px;
				line-height: 1.1;
				color: #3d2914;
			}

			.gift-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 7px;
			}

			.gift-list li {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 6px 8px;
				font-size: 14px;
				line-height: 1.35;
				color: #2a1b0d;
				background: transparent;
				transition: background 0.15s ease, transform 0.15s ease;
			}

			.gift-list a {
				color: #1155cc;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 2px;
			}

			.gift-list a:hover {
				color: #0b3d91;
			}

			.gift-list li:hover {
				background: rgba(126, 200, 80, 0.18);
				transform: translateX(3px);
			}

			.gift-list li.shout {
				background: rgba(230, 57, 70, 0.1);
				border: 2px solid rgba(198, 40, 40, 0.35);
				font-weight: 700;
			}

			.gift-list li.shout a {
				color: #c62828;
				font-weight: 700;
			}

			.gift-list li.shout a:hover {
				color: #8e1b1b;
			}

			.shout-tag {
				margin-left: auto;
				font-family: "Pixelify Sans", "VT323", monospace;
				font-style: normal;
				font-size: 12px;
				letter-spacing: 0.04em;
				color: #c62828;
				animation: pulse-text 1.2s ease-in-out infinite;
			}

			@keyframes heartbeat {
				0%, 100% { transform: scale(1); }
				35% { transform: scale(1.12); }
				55% { transform: scale(0.96); }
			}

			@keyframes drift {
				from { background-position: 0 0, 0 0; }
				to { background-position: 64px 32px, 64px 32px; }
			}

			@keyframes rise-in {
				from {
					opacity: 0;
					transform: translateY(10px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes pulse-text {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.55; }
			}

			@media (max-width: 768px) {
				body {
					padding: 12px;
				}

				.page {
					padding: 12px;
				}

				.game-frame {
					margin: 8px;
					padding: 12px;
				}

				.hero {
					align-items: center;
				}

				.boards {
					grid-template-columns: 1fr;
				}

				.shout-tag {
					margin-left: 0;
				}

				.gift-list li.shout {
					flex-wrap: wrap;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.hero-heart,
				.shout-tag,
				.game-shell::before,
				.board {
					animation: none;
				}

				.gift-list li:hover {
					transform: none;
				}
			}
		</style>
	</body>
</html>
