---
import SiteHeader from "../../components/SiteHeader.astro";

const posts = [
	{
		title: "You should work out of whatever platform you like",
		href: "/blog/platform-agnostic-work",
	},
	{
		title: "Humans love bathing",
		href: "/blog/humans-love-bathing",
	},
	{
		title: "Confessions of a Hedonist",
		href: "/blog/confessions-of-a-hedonist",
	},
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Scribbles - HEYMART</title>
	</head>
	<body>
		<main class="page">
			<SiteHeader />
			<section class="blog-box" aria-labelledby="blog-heading">
				<div class="box-header">
					<h1 id="blog-heading">Scribbles</h1>
				</div>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={post.href}>{post.title}</a>
						</li>
					))}
				</ul>
			</section>
		</main>

		<style>
			* {
				box-sizing: border-box;
			}

			html {
				font-family: Verdana, system-ui, sans-serif;
				background: #3d3d3d;
				color: #1a1a1a;
			}

			body {
				margin: 0;
				min-height: 100vh;
				padding: 32px;
			}

			.page {
				width: min(920px, 100%);
				margin: 0 auto;
				background: #ffffff;
				border-radius: 8px;
				padding: 30px;
			}

			.post-list a {
				color: #1155cc;
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 2px;
				font-weight: 700;
			}

			.blog-box {
				border: 6px solid #d4f2ff;
				border-radius: 8px;
				overflow: hidden;
			}

			.box-header {
				background: linear-gradient(180deg, #2ab7ff 0%, #008bd6 100%);
				color: #ffffff;
				padding: 18px 24px;
			}

			h1 {
				margin: 0;
				font-size: 40px;
				line-height: 1.15;
			}

			.post-list {
				list-style: none;
				margin: 0;
				padding: 28px;
				display: flex;
				flex-direction: column;
				gap: 22px;
			}

			.post-list li {
				display: flex;
				flex-direction: column;
				gap: 6px;
			}

			@media (max-width: 640px) {
				body {
					padding: 12px;
				}

				.page {
					padding: 16px;
				}

				.box-header,
				.post-list {
					padding: 18px;
				}

				h1 {
					font-size: 32px;
				}
			}
		</style>
	</body>
</html>
